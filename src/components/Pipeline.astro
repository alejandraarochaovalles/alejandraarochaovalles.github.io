---
import { pipeline } from '../data/profile';
---

<figure class="pipe" aria-label="Refinement pipeline: raw story through five agents to Jira">
  <figcaption class="mono pipe__cap">Refinement pipeline · in production</figcaption>
  <ol class="pipe__flow">
    {pipeline.map((n, i) => (
      <li class:list={['pipe__node', n.highlight && 'is-key']} style={`--d:${i * 90}ms`}>
        <span class="pipe__step">{n.step}</span>
        <span class="mono pipe__note">{n.note}</span>
      </li>
    ))}
  </ol>
</figure>

<style>
  .pipe {
    margin: 0;
  }

  .pipe__cap {
    display: block;
    margin-bottom: 0.9rem;
  }

  .pipe__flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
  }

  @media (min-width: 34rem) {
    .pipe__flow { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 62rem) {
    .pipe__flow { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  }

  .pipe__node {
    position: relative;
    min-width: 0;
    padding: 0.7rem 0.9rem 0.75rem;
    background: var(--paper-2);
    border-top: 2px solid var(--wire);
    animation: rise 0.5s ease both;
    animation-delay: var(--d);
  }

  .pipe__node.is-key {
    border-top-color: var(--signal);
    background: #e7dde2;
  }

  .pipe__step {
    display: block;
    font-weight: 600;
    font-size: 0.86rem;
    line-height: 1.25;
  }

  .pipe__note {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.64rem;
    letter-spacing: 0.06em;
  }

  .is-key .pipe__note {
    color: var(--signal);
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pipe__node { animation: none; }
  }
</style>
