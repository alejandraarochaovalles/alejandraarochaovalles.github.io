---
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import Pipeline from '../components/Pipeline.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { thesis, expertise, projects, experience, earlier, credentials, writing, person } from '../data/profile';
---

<Base>
  <div class="shell">
    <Rail />

    <main class="main">
      <section class="hero">
        <h2 class="hero__line">{thesis.headline}</h2>
        <p class="hero__body">{thesis.body}</p>
        <div class="hero__pipe"><Pipeline /></div>
      </section>

      <section class="block" aria-labelledby="expertise">
        <h2 id="expertise" class="mono block__title">What I do</h2>
        <hr class="threshold" />
        <ul class="exp-list reveal">
          {expertise.map((e) => <li class="exp-list__item">{e}</li>)}
        </ul>
      </section>

      <section class="block" aria-labelledby="systems">
        <h2 id="systems" class="mono block__title">Systems I've built</h2>
        {projects.map((p) => <ProjectRow project={p} />)}
      </section>

      <section class="block" aria-labelledby="experience">
        <h2 id="experience" class="mono block__title">Experience</h2>
        <hr class="threshold" />
        <ol class="roles">
          {experience.map((r) => (
            <li class="role reveal">
              <div class="role__head">
                <span class="mono role__period">{r.period}</span>
                <h3 class="role__org">{r.org}</h3>
                <p class="mono role__title">{r.role}</p>
              </div>
              <ul class="role__points">
                {r.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </li>
          ))}
        </ol>

        <div class="earlier reveal">
          <h3 class="mono earlier__title">Earlier — Scrum Master & Agile roles</h3>
          <ul class="earlier__list">
            {earlier.map((e) => (
              <li class="earlier__item">
                <span class="earlier__org">{e.org}</span>
                <span class="mono earlier__role">{e.role}</span>
                <span class="earlier__note">{e.note}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="block" aria-labelledby="credentials">
        <h2 id="credentials" class="mono block__title">Education, certifications & tools</h2>
        <hr class="threshold" />
        <div class="creds reveal">
          <div class="creds__col">
            <h3 class="mono creds__label">Education</h3>
            <ul class="creds__list">
              {credentials.education.map((e) => (
                <li><strong class="creds__strong">{e.title}</strong><span class="creds__where">{e.where}</span></li>
              ))}
            </ul>
          </div>
          <div class="creds__col">
            <h3 class="mono creds__label">Certifications</h3>
            <ul class="creds__list">
              {credentials.certifications.map((c) => <li>{c}</li>)}
            </ul>
          </div>
          <div class="creds__col creds__col--wide">
            <h3 class="mono creds__label">Tools</h3>
            <ul class="creds__tags">
              {credentials.tools.map((t) => <li class="mono creds__tag">{t}</li>)}
            </ul>
            <p class="creds__lang">{credentials.languages}</p>
          </div>
        </div>
      </section>

      <section class="block" aria-labelledby="writing">
        <h2 id="writing" class="mono block__title">Writing</h2>
        <hr class="threshold" />
        <div class="write reveal">
          <p class="write__intro">
            I write <a class="write__nl" href={writing.newsletterHref}>{writing.newsletter}</a>,
            a newsletter on how delivery, tooling and people actually interact.
          </p>
          <ul class="write__list">
            {writing.pieces.map((w) => (
              <li><a class="write__piece" href={w.href}>{w.title}</a></li>
            ))}
          </ul>
        </div>
      </section>

      <footer class="foot">
        <hr class="threshold" />
        <p class="foot__cta">
          Available for senior coaching and delivery roles, remote across the EU and UK, or as a B2B contract.
        </p>
        <a class="foot__mail" href={`mailto:${person.email}`}>{person.email}</a>
        <p class="mono foot__meta">
          Built with Astro · <a href="https://github.com/alejandraarochaovalles-svg">source for this site</a>
        </p>
      </footer>
    </main>
  </div>
</Base>

<style>
  .main { padding: clamp(2.5rem, 6vw, 4.5rem) 0 4rem; }

  .hero__line {
    font-family: var(--display);
    font-optical-sizing: auto;
    font-weight: 500;
    font-size: clamp(1.65rem, 4.6vw, 2.65rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin: 0;
    max-width: 24ch;
    text-wrap: balance;
  }

  .hero__body {
    max-width: var(--measure);
    margin: 1.4rem 0 0;
    font-size: 1.05rem;
    color: var(--slate);
  }

  .hero__pipe { margin-top: 2.75rem; }

  .block { margin-top: 4.5rem; }

  .block__title {
    margin: 0 0 1.1rem;
    font-size: 0.72rem;
    color: var(--signal);
  }

  /* What I do */
  .exp-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.55rem 2rem;
    font-size: 0.95rem;
  }

  .exp-list__item {
    padding-left: 1rem;
    position: relative;
    color: var(--slate);
  }

  .exp-list__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 1px;
    background: var(--signal);
  }

  @media (min-width: 46rem) {
    .exp-list { grid-template-columns: 1fr 1fr; }
  }

  /* Experience */
  .roles { list-style: none; margin: 0; padding: 0; }

  .role {
    padding: 1.8rem 0;
    border-bottom: 1px solid var(--wire);
    display: grid;
    gap: 0.9rem;
  }

  .role__period { display: block; font-size: 0.66rem; }

  .role__org {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: -0.015em;
    margin: 0.35rem 0 0;
  }

  .role__title {
    margin: 0.25rem 0 0;
    color: var(--flag);
    font-size: 0.66rem;
  }

  .role__points {
    margin: 0;
    padding-left: 1.05rem;
    max-width: var(--measure);
    color: var(--slate);
    font-size: 0.93rem;
  }

  .role__points li { margin-bottom: 0.4rem; }
  .role__points li::marker { color: var(--wire); }

  @media (min-width: 52rem) {
    .role {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 0 2.5rem;
    }
  }

  /* Earlier */
  .earlier { padding-top: 2rem; }

  .earlier__title { margin: 0 0 0.9rem; font-size: 0.66rem; }

  .earlier__list { list-style: none; margin: 0; padding: 0; }

  .earlier__item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.9rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--wire);
  }

  .earlier__org { font-weight: 600; font-size: 0.95rem; }

  .earlier__role { font-size: 0.62rem; color: var(--flag); }

  .earlier__note { font-size: 0.88rem; color: var(--slate); }

  /* Credentials */
  .creds {
    display: grid;
    gap: 2rem;
    padding-top: 1.8rem;
  }

  .creds__label { margin: 0 0 0.8rem; font-size: 0.62rem; }

  .creds__list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.92rem;
    color: var(--slate);
  }

  .creds__list li { padding: 0.35rem 0; }

  .creds__strong { display: block; color: var(--ink); font-weight: 600; }

  .creds__where { font-size: 0.85rem; }

  .creds__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .creds__tag {
    font-size: 0.66rem;
    padding: 0.25rem 0.5rem;
    background: var(--paper-2);
  }

  .creds__lang {
    margin: 1rem 0 0;
    font-size: 0.88rem;
    color: var(--slate);
  }

  @media (min-width: 46rem) {
    .creds { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .creds__col--wide { grid-column: 1 / -1; }
  }

  /* Writing */
  .write { padding-top: 1.6rem; }

  .write__intro { max-width: var(--measure); margin: 0; font-size: 1.02rem; }

  .write__nl {
    color: var(--flag);
    text-decoration-color: var(--wire);
    text-underline-offset: 3px;
  }

  .write__list { list-style: none; padding: 0; margin: 1.2rem 0 0; }

  .write__list li { border-top: 1px solid var(--wire); padding: 0.85rem 0; }

  .write__piece {
    text-decoration: none;
    font-weight: 500;
    max-width: var(--measure);
    display: inline-block;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .write__piece:hover { border-color: var(--signal); }

  /* Footer */
  .foot { margin-top: 4.5rem; }

  .foot__cta {
    max-width: var(--measure);
    margin: 1.6rem 0 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.15rem, 2.6vw, 1.4rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .foot__mail {
    display: inline-block;
    margin-top: 0.9rem;
    font-family: var(--mono);
    font-size: 0.9rem;
    color: var(--signal);
    text-decoration: none;
    border-bottom: 1px solid var(--wire);
    word-break: break-all;
  }

  .foot__mail:hover { border-color: var(--signal); }

  .foot__meta { margin-top: 2.5rem; font-size: 0.66rem; }
</style>
